# 复制为 .env 或在启动前 export。所有项都是可选的；不设置时使用默认值。
# 本项目不会自动读取 .env 文件，请用 `set -a; source .env; set +a` 或由进程管理器注入。

# 监听地址与端口
APP_HOST=127.0.0.1
APP_PORT=5050
# APP_PORT_STRICT=1
# APP_THREADS=8

# 时区与对外地址（签到二维码、邮件链接）
APP_TIMEZONE=Asia/Shanghai
# PUBLIC_BASE_URL=https://lab.example.com

# 会话密钥：留空则首次启动自动生成并保存到 data/secret_key
# SECRET_KEY=

# 邮件（SMTP）。授权码只从 MAIL_PASSWORD_ENV 指定的环境变量读取
# MAIL_HOST=smtp.example.com
# MAIL_PORT=465
# MAIL_USE_SSL=true
# MAIL_USERNAME=noreply@example.com
# MAIL_FROM=noreply@example.com
# MAIL_FROM_NAME=实验室预约系统
# MAIL_PASSWORD_ENV=SMTP_AUTH_CODE
# SMTP_AUTH_CODE=
# MAIL_SEND_ENABLED=false
# 可选 HTTP 代理（为空时直连）
# MAIL_PROXY_HOST=
# MAIL_PROXY_PORT=8080
